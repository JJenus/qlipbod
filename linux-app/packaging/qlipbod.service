# Qlipbod LAN clipboard sync daemon — systemd user unit (plan §8)
#
# Run qlipbod as a per-user service so it starts at login and survives app
# restarts without root. The daemon advertises + browses mDNS, watches the
# clipboard, and accepts paired connections.
#
# Install (see README.md in this directory):
#   1. build/install the application distribution (./gradlew :linux-app:installDist)
#   2. copy this unit to ~/.config/systemd/user/qlipbod.service, fix ExecStart paths
#   3. systemctl --user daemon-reload
#   4. systemctl --user enable --now qlipbod

[Unit]
Description=Qlipbod LAN clipboard sync daemon
# Discovery (mDNS) and pairing only make sense once the network is up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/qlipbod/bin/linux-app start --data-dir %h/.local/share/qlipbod
Restart=on-failure
RestartSec=2

# Hardening: the daemon needs only network + its state dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/usr /etc
ReadWritePaths=%h/.local/share/qlipbod

[Install]
WantedBy=default.target